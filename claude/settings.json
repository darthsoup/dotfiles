{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution" : {
    "commit" : "",
    "pr" : ""
  },
  "effortLevel" : "high",
  "enabledPlugins" : {
    "claude-code-setup@claude-plugins-official" : true,
    "context7@claude-plugins-official" : true,
    "stitch-build@google-labs-code-stitch-skills" : true,
    "stitch-design@google-labs-code-stitch-skills" : true,
    "stitch-utilities@google-labs-code-stitch-skills" : true
  },
  "includeGitInstructions" : false,
  "outputStyle" : "Concise",
  "permissions" : {
    "allow" : [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch",
      "WebSearch(*)",
      "Skill(context7-auto-research:*)",
      "mcp__chrome-devtools__*",
      "mcp__context7__*",
      "Bash(npm test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(composer:*)",
      "Bash(php artisan:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(pnpm:*)",
      "Bash(touch:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(diff:*)"
    ],
    "deny" : [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard origin/*)*",
      "Bash(git clean -f*)*",
      "Bash(npm publish)*",
      "Bash(pnpm publish)*",
      "Bash(yarn publish)*",
      "Bash(docker system prune)*",
      "Read(.\/.env)",
      "Read(.\/.env.*)",
      "Read(!.env.example)",
      "Read(.\/secrets\/**)"
    ],

    "defaultMode" : "plan"
  },
  "sandbox" : {
    "filesystem" : {}
  },
  "statusLine" : {
    "type" : "command",
    "command" : "~/.claude/statusline.sh"
  }
}
